<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/chat_item_height"
    android:background="@color/chat_background">

    <TextView
        android:id="@+id/avatar"
        android:layout_width="@dimen/chat_avatar_size"
        android:layout_height="@dimen/chat_avatar_size"
        android:layout_marginStart="10dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/bg_avatar"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:backgroundTint="#65AADD"
        tools:text="DM" />

    <!-- Заголовок и значки за ним: packed-цепочка, заголовок сжимается с многоточием -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_text_start"
        android:layout_marginTop="@dimen/chat_content_vertical_margin"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/chat_text_primary"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/mute"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Dima Murantsev" />

    <ImageView
        android:id="@+id/mute"
        android:layout_width="@dimen/chat_icon_size"
        android:layout_height="@dimen/chat_icon_size"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mute"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/verified"
        app:layout_constraintStart_toEndOf="@id/title"
        app:layout_constraintTop_toTopOf="@id/title"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/verified"
        android:layout_width="@dimen/chat_icon_size"
        android:layout_height="@dimen/chat_icon_size"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_verified"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/scam"
        app:layout_constraintStart_toEndOf="@id/mute"
        app:layout_constraintTop_toTopOf="@id/title"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/scam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_scam"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="4dp"
        android:text="@string/scam"
        android:textColor="@color/chat_scam"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintEnd_toStartOf="@id/status"
        app:layout_constraintStart_toEndOf="@id/verified"
        app:layout_constraintTop_toTopOf="@id/title"
        app:layout_goneMarginEnd="8dp"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/status"
        android:layout_width="@dimen/chat_icon_size"
        android:layout_height="@dimen/chat_icon_size"
        android:layout_marginEnd="2dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/time"
        app:layout_constraintEnd_toStartOf="@id/time"
        app:layout_constraintTop_toTopOf="@id/time"
        tools:src="@drawable/ic_check"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="@dimen/chat_edge_margin"
        android:textColor="@color/chat_text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="11:38" />

    <!-- Автор есть только у групп; без него сообщение поднимается к заголовку -->
    <TextView
        android:id="@+id/author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_text_start"
        android:layout_marginTop="@dimen/chat_author_margin_top"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/chat_text_primary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/badges"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Nikolay"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/preview"
        android:layout_width="@dimen/chat_icon_size"
        android:layout_height="@dimen/chat_icon_size"
        android:layout_marginStart="@dimen/chat_text_start"
        android:background="@drawable/bg_preview"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/message"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="@id/message"
        tools:backgroundTint="#5B8DEF"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="@dimen/chat_message_margin_top"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/chat_text_secondary"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/badges"
        app:layout_constraintStart_toEndOf="@id/preview"
        app:layout_constraintTop_toBottomOf="@id/author"
        app:layout_goneMarginStart="@dimen/chat_text_start"
        app:layout_goneMarginTop="@dimen/chat_message_gone_margin_top"
        tools:text="you are welcome :)" />

    <LinearLayout
        android:id="@+id/badges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="@dimen/chat_edge_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/mention"
            android:layout_width="@dimen/chat_badge_size"
            android:layout_height="@dimen/chat_badge_size"
            android:background="@drawable/bg_mention"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_mention"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/pinned"
            android:layout_width="@dimen/chat_badge_size"
            android:layout_height="@dimen/chat_badge_size"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pinned"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:rotation="45"
            android:src="@drawable/ic_pin"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chat_badge_size"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_counter"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="@dimen/chat_badge_size"
            android:paddingHorizontal="7dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone"
            tools:backgroundTint="@color/chat_accent"
            tools:text="50"
            tools:visibility="visible" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
